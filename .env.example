# Copiez ce fichier vers .env et renseignez vos propres valeurs.
# Ne jamais commiter .env (déjà ignoré par git).

# Connexion Postgres (ex: Prisma Postgres, https://console.prisma.io)
#
# ATTENTION si la base est une Prisma Postgres (db.prisma.io) : la console
# propose deux clés dans "Connection strings" — utilisez bien celle nommée
# "Any client" (une URL postgres:// standard), PAS "Prisma ORM" (protocole
# propriétaire Prisma). Ce projet utilise le driver Postgres standard
# (@prisma/adapter-pg), pas le client Prisma natif : coller la mauvaise
# clé provoque des erreurs de connexion (ETIMEDOUT) qui ressemblent à un
# problème réseau alors que c'est juste la mauvaise chaîne de connexion.
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Stripe (mode test) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Optionnel, uniquement pour le webhook de production (/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=""

# Accès admin (/admin)
ADMIN_PASSWORD="changeme"
# Chaîne aléatoire longue, ex: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# Signature des sessions de comptes client (/compte). Chaîne aléatoire longue,
# ex: openssl rand -hex 32. Si absente, ADMIN_SESSION_SECRET est réutilisée.
SESSION_SECRET=""

# Emails transactionnels (newsletter, confirmation de commande) — https://resend.com/api-keys
RESEND_API_KEY=""
# Doit être un domaine vérifié dans Resend une fois en production
RESEND_FROM_EMAIL="Fasshon <onboarding@resend.dev>"
