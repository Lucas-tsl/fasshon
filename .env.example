# Copiez ce fichier vers .env et renseignez vos propres valeurs.
# Ne jamais commiter .env (déjà ignoré par git).

# Connexion Postgres (ex: Prisma Postgres, https://console.prisma.io)
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Stripe (mode test) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Optionnel, uniquement pour le webhook de production (/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=""

# Accès admin (/admin)
ADMIN_PASSWORD="changeme"
# Chaîne aléatoire longue, ex: openssl rand -hex 32
ADMIN_SESSION_SECRET=""
